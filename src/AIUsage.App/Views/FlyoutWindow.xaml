<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIUsage.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AIUsage.App.Views"
    xmlns:vm="using:AIUsage.App.ViewModels"
    xmlns:res="using:AIUsage.Core.Resources">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <StackPanel x:Name="Root" VerticalAlignment="Top">
        <StackPanel.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </StackPanel.KeyboardAccelerators>

        <ItemsControl ItemsSource="{x:Bind ViewModel.Providers}" Margin="16,16,16,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderViewModel">
                    <StackPanel Spacing="8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,4">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" VerticalAlignment="Center" />
                            <Border Visibility="{x:Bind views:FlyoutWindow.VisibleIf(Plan), Mode=OneWay}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,1,8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Plan, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <InfoBar IsOpen="{x:Bind views:FlyoutWindow.HasText(StatusMessage), Mode=OneWay}" IsClosable="False"
                                 Message="{x:Bind StatusMessage, Mode=OneWay}" Severity="{x:Bind StatusSeverity, Mode=OneWay}" />

                        <ItemsControl ItemsSource="{x:Bind Windows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WindowViewModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,10,14,12">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            </Grid>
                                            <Border Height="6" CornerRadius="3" Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                                                <Rectangle Fill="{x:Bind views:FlyoutWindow.LevelBrush(Level), Mode=OneWay}"
                                                           Scale="{x:Bind BarScale, Mode=OneWay}">
                                                    <Rectangle.ScaleTransition>
                                                        <Vector3Transition Duration="0:0:0.45" />
                                                    </Rectangle.ScaleTransition>
                                                </Rectangle>
                                            </Border>
                                            <TextBlock Text="{x:Bind ResetText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Padding aligns the text and the outer glyph edge with the card content above (16 margin + 1 border + 14 padding);
             the 32 px buttons put their 16 px glyph 8 px inside the button box. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Padding="31,8,23,8"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.Resources>
                <Storyboard x:Name="RefreshSpin" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="RefreshRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8" />
                </Storyboard>
                <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </Grid.Resources>
            <TextBlock Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource FooterButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="{x:Bind res:Strings.Flyout_Refresh}" AutomationProperties.Name="{x:Bind res:Strings.Flyout_Refresh}">
                <FontIcon Glyph="&#xE72C;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform x:Name="RefreshRotation" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource FooterButtonStyle}" Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="{x:Bind res:Strings.Flyout_Settings}" AutomationProperties.Name="{x:Bind res:Strings.Flyout_Settings}">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>
    </StackPanel>
</Window>
