<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIUsage.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AIUsage.App.ViewModels"
    xmlns:res="using:AIUsage.Core.Resources">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Spacing="16" Padding="24,20,24,16">
                <NumberBox Header="{x:Bind res:Strings.Settings_PollInterval}" Value="{x:Bind ViewModel.PollIntervalSeconds, Mode=TwoWay}"
                           Minimum="180" SmallChange="30" LargeChange="60" SpinButtonPlacementMode="Compact" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <NumberBox Header="{x:Bind res:Strings.Settings_WarningThreshold}" Value="{x:Bind ViewModel.WarningThreshold, Mode=TwoWay}"
                               Minimum="1" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                    <NumberBox Grid.Column="1" Header="{x:Bind res:Strings.Settings_CriticalThreshold}" Value="{x:Bind ViewModel.CriticalThreshold, Mode=TwoWay}"
                               Minimum="1" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind res:Strings.Settings_IconWindows}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.IconWindows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IconWindowOption">
                                <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ToggleSwitch Header="{x:Bind res:Strings.Settings_Autostart}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                <ToggleSwitch Header="{x:Bind res:Strings.Settings_Notifications}" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                <TextBox Header="{x:Bind res:Strings.Settings_CredentialsPath}" Text="{x:Bind ViewModel.CredentialsPath, Mode=TwoWay}"
                         PlaceholderText="{x:Bind ViewModel.DefaultCredentialsPath}" />
                <ComboBox Header="{x:Bind res:Strings.Settings_Language}" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" MinWidth="200">
                    <x:String>Deutsch</x:String>
                    <x:String>English</x:String>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="24,12,24,20">
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind res:Strings.Settings_Save}"
                    Command="{x:Bind ViewModel.SaveCommand}" MinWidth="110" />
            <Button Grid.Column="2" Content="{x:Bind res:Strings.Settings_Cancel}" Command="{x:Bind ViewModel.CancelCommand}" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
