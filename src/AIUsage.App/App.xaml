<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AIUsage.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Usage level colors, kept in sync with the tray icon renderer. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LevelNormalBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="LevelWarningBrush" Color="#C76A00" />
                    <SolidColorBrush x:Key="LevelCriticalBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LevelNormalBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="LevelWarningBrush" Color="#FFB03A" />
                    <SolidColorBrush x:Key="LevelCriticalBrush" Color="#FF6B5E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
